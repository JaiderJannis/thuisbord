# Kopieer naar .env en vul in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jouw@mail.be
# Zelf verzonnen lang wachtwoord (bv. uit: openssl rand -hex 24)
SHARED_KEY=
# Het adres waar je Thuisbord draait (geen slash op het einde)
ALLOWED_ORIGIN=https://jaiderjannis.github.io
# Home Assistant (intern adres) en een Long-Lived Access Token
HA_URL=http://192.168.1.50:8123
HA_TOKEN=
PORT=8787
# Optioneel: gratis KNMI-sleutel (Web Map Service) voor de regenvoorspelling op de kaart
KNMI_KEY=
